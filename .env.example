# Copy to .env.local for development. Names only; never commit values.
# Anything NOT prefixed NEXT_PUBLIC_ stays on the server.

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Server-only. Read token used by page queries when the dataset is PRIVATE (recommended, see README "hiddenPrice").
SANITY_API_READ_TOKEN=
# Server-only. Viewer token used ONLY by src/sanity/server/price.ts (the /api/price-reveal route).
SANITY_API_TOKEN=

# --- Email (Resend), server-only ---
RESEND_API_KEY=
# Where form submissions are sent
NOTIFICATION_EMAIL=

# --- Site ---
# https://funeralalfa.com in production, https://staging.funeralalfa.com on staging
NEXT_PUBLIC_SITE_URL=
# Leave unset/false until launch: robots.txt disallows everything and pages are noindex.
ALLOW_INDEXING=

# --- Reserved for later phases (not read by any code yet) ---
# Google Places reviews (Phase 4), server-only
GOOGLE_PLACES_API_KEY=
# CallRail: no script is loaded until the consent banner exists (Phase 5)
NEXT_PUBLIC_CALLRAIL_ACCOUNT_ID=
