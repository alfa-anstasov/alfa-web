{
  "name": "alfa-web",
  "version": "0.1.0",
  "private": true,
  "description": "funeralalfa.com - website of Траурни услуги АЛФА",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
